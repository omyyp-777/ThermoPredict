# Backend environment variables. Set these in Render dashboard, not in frontend.
COMFORT_LIMIT_C=30.0
ELECTRICITY_RATE_INR_PER_KWH=8.0
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_TABLE=telemetry
FRONTEND_ORIGINS=https://YOUR-APP.vercel.app
# Optional: same secret configured in ESP32 firmware header.
DEVICE_API_TOKEN=CHANGE_TO_A_LONG_RANDOM_SECRET
# Optional Nugen settings. Configure only from Nugen's official API documentation.
NUGEN_API_KEY=
NUGEN_API_BASE_URL=
NUGEN_API_KEY_HEADER=Authorization
NUGEN_API_KEY_PREFIX=Bearer
